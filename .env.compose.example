# Copy this file to .env before running docker compose up --build -d
# Use unique values; do not commit your real .env file.
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
MESSAGEX_ADMIN_USERNAME=admin
MESSAGEX_ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# Host-published ports. Container ports remain 5678 (broker) and 80 (dashboard).
TCP_BIND_ADDRESS=0.0.0.0
TCP_PORT=5678
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=15672

# Optional local image tags
BROKER_IMAGE=messagex-broker:local
DASHBOARD_IMAGE=messagex-dashboard:local
