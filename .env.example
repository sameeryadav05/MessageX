
# Network configuration
# 127.0.0.1 = local-only
# 0.0.0.0 = listen on all network interfaces
HOST=127.0.0.1

HTTP_PORT=3000
TCP_PORT=5678

DATABASE_URL=postgresql://messagex:messagex_dev_password@localhost:5433/messagex

# Message delivery reliability
ACK_TIMEOUT_SECONDS=30
ACK_TIMEOUT_CHECK_INTERVAL_MS=5000
MESSAGEX_ADMIN_USERNAME=admin
MESSAGEX_ADMIN_PASSWORD=replace_with_a_unique_strong_password
