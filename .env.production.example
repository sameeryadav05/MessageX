# Docker Hub account and release version
DOCKERHUB_USERNAME=your_dockerhub_username
MESSAGEX_VERSION=0.1.0

# Generate unique secrets. Use hexadecimal values for POSTGRES_PASSWORD
# because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_64_character_hex_secret
MESSAGEX_ADMIN_USERNAME=admin
MESSAGEX_ADMIN_PASSWORD=replace_with_a_unique_64_character_hex_secret

# Public dashboard domain and Let's Encrypt contact email
MESSAGEX_DOMAIN=your-domain.example.com
LETSENCRYPT_EMAIL=you@example.com

# Keep TCP private until broker TCP TLS is implemented.
TCP_BIND_ADDRESS=127.0.0.1

# Optional message delivery settings
ACK_TIMEOUT_SECONDS=30
ACK_TIMEOUT_CHECK_INTERVAL_MS=5000
